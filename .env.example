# Copy to .env and fill in only the providers you use.
# Tests never read these: they run on deterministic fakes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Where docsage keeps its index (vector store, BM25, caches).
DOCSAGE_HOME=.docsage
# API service: embedder (hashing or sentence-transformers) and LLM (openai, anthropic, ollama).
DOCSAGE_EMBEDDER=hashing
DOCSAGE_LLM=ollama
DOCSAGE_LLM_MODEL=
